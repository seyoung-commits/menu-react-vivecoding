# 환경변수 이름 안내용입니다. 실제 비밀 값은 커밋하지 마세요.
# Spring Boot는 이 파일이나 .env를 자동으로 읽지 않습니다.
# Windows 환경변수 또는 IntelliJ 실행 설정에 등록하고 IDE/터미널을 다시 여세요.

# 필수: 실제 MySQL 계정의 비밀번호
DB_PASSWORD=

# 기본값을 바꿀 때만 설정
DB_URL=jdbc:mysql://localhost:3306/menudb
DB_USERNAME=ohgiraffers

# 카카오 로그인: 카카오 개발자센터에서 발급
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 간편가입/약관을 앱에 설정한 경우에만 활성화
KAKAO_SYNC_ENABLED=false
KAKAO_SYNC_REQUIRED_TERMS=menu_terms_20261005

# AI 기능
OPENAI_API_KEY=
# 모델 변경 시 선택 설정
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# 카카오페이 테스트 결제 기능 사용 시
KAKAOPAY_SECRET_KEY=

# 메뉴 사진 저장 위치 (선택)
MENU_UPLOAD_DIR=./uploads/menu-images
